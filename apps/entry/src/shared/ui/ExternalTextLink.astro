---
import type { ExternalLink } from "@/shared/terms";

interface Props {
  link: ExternalLink;
  keepIconWithLastWord?: boolean;
}

const { link, keepIconWithLastWord = false } = Astro.props;
const lastSpace = link.label.lastIndexOf(" ");
const prefix = link.label.slice(0, lastSpace + 1);
const lastWord = link.label.slice(lastSpace + 1);
---

<a
  href={link.href}
  class:list={[
    "group min-h-6 font-semibold text-text-primary decoration-brand-base",
    {
      "inline-flex items-baseline gap-2": !keepIconWithLastWord,
      "inline-block": keepIconWithLastWord,
    },
  ]}
  aria-label={`${link.label}: ${link.context}`}
>
  {keepIconWithLastWord ? (
    <span class="group-hover:text-brand-hover">{prefix}<span class="whitespace-nowrap">{lastWord}<span aria-hidden="true" class="ms-2 text-brand-strong">↗</span></span></span>
  ) : (
    <>
      <span class="group-hover:text-brand-hover">{link.label}</span>
      <span aria-hidden="true" class="text-brand-strong">↗</span>
    </>
  )}
</a>

---
import House from "phosphor-astro/House.astro";

interface Props {
  title: string;
  homeLabel: string;
}

const { title, homeLabel } = Astro.props;
---

<div class="flex items-center justify-between gap-3">
  <h1 class="text-display font-semibold text-text-primary">{title}</h1>
  <a
    class="home-link inline-flex size-10 shrink-0 items-center justify-center rounded-xl"
    href="/"
    aria-label={homeLabel}
  >
    <House aria-hidden="true" class="size-6" />
  </a>
</div>

<style>
  .home-link {
    color: var(--color-brand-strong);
  }

  @media (hover: hover) {
    .home-link:hover {
      background: var(--color-brand-strong);
      color: var(--color-surface-default);
    }
  }
</style>

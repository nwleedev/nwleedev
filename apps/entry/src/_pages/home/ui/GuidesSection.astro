---
import type { HomeTerms } from "@/shared/terms";
import { SectionHeader } from "@/shared/ui";
import MarkdownLogo from "phosphor-astro/MarkdownLogo.astro";

interface Props {
  guides: HomeTerms["guides"];
}

const { guides } = Astro.props;
const { frontend } = guides;
---

<section aria-labelledby="guides" class="pb-16 md:pb-24">
  <SectionHeader id="guides" title={guides.title} />
  <p class="mt-8 text-base leading-7 text-text-secondary">{guides.description}</p>
  <ul class="mt-8">
    <li>
      <div class="flex items-center justify-between gap-4">
        <h3 class="text-item font-semibold text-text-primary">
          <a href="/codes/frontend" hreflang="ko" class="block underline decoration-current">
            {frontend.title}
          </a>
        </h3>
        <a
          href="/codes/frontend.md"
          hreflang="ko"
          aria-label={frontend.markdownLabel}
          class="inline-flex size-11 shrink-0 items-center justify-center"
        >
          <MarkdownLogo aria-hidden="true" class="size-6 text-guide-source" />
        </a>
      </div>
      <p class="mt-4 text-base leading-7 text-text-secondary">{frontend.description}</p>
    </li>
  </ul>
</section>

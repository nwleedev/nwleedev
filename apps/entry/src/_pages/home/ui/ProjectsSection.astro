---
import type { HomeTerms } from "@/shared/terms";
import { ExternalTextLink, MetadataLine, SectionHeader } from "@/shared/ui";

type ProjectsTerms = HomeTerms["projects"];

interface Props {
  projects: ProjectsTerms;
}

const { projects } = Astro.props;
---

<section aria-labelledby={projects.id} class="pb-16 md:pb-24">
  <SectionHeader id={projects.id} title={projects.title} />
  <ul class="mt-8">
    {projects.items.map((item) => (
      <li class="border-t border-border-default py-9 first:border-t-0 first:pt-0 md:py-10 md:first:pt-0">
        <h3 class="text-item font-semibold text-text-primary">
          {item.serviceLink ? (
            <ExternalTextLink link={{ label: item.title, ...item.serviceLink }} keepIconWithLastWord />
          ) : item.title}
        </h3>
        <div class="mt-4 space-y-4 text-base leading-7 text-text-secondary">
          {item.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        {item.links.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-3">
            {item.links.map((link) => (
              <li><ExternalTextLink link={link} keepIconWithLastWord /></li>
            ))}
          </ul>
        )}
        <div class="mt-7">
          <MetadataLine period={item.period} technologies={item.technologies} />
        </div>
      </li>
    ))}
  </ul>
</section>

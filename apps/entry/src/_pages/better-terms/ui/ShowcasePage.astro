---
import { getShowcaseTerms } from "@/shared/terms";
import { BaseLayout, PageFooter } from "@/shared/ui";
import House from "phosphor-astro/House.astro";
import { examples } from "../model/article";
import { groups } from "../model/changes";
import { sourceParts } from "../model/source";
import SourceTokens from "./SourceTokens.astro";

const { showcase, footer, skipLink } = getShowcaseTerms();
const groupedExamples = groups.map((group) => ({
  ...group,
  examples: examples.filter((example) => example.section.groupId === group.id),
}));
---

<BaseLayout locale="ko" title={showcase.title} description={showcase.description}>
  <a
    href="#main-content"
    class="fixed start-4 top-4 z-50 -translate-y-24 bg-text-primary px-4 py-2 text-surface-default focus:translate-y-0"
  >
    {skipLink}
  </a>
  <div class="showcase-page">
  <main id="main-content" class="mx-auto max-w-page px-(--page-gutter)" tabindex="-1" data-showcase>
    <header class="pt-16">
      <a class="home-link inline-flex size-8 items-center justify-center" href="/" aria-label={showcase.homeLabel}>
        <House aria-hidden="true" class="size-6" />
      </a>
      <h1 class="mt-8 text-display font-semibold text-text-primary">{showcase.title}</h1>
      <p class="mt-4 text-base text-text-secondary">{showcase.description}</p>
    </header>

    <div class="mt-6 hidden sm:block">
      <div class="sticky top-0 z-10 flex justify-end bg-surface-default py-2">
        <button
          type="button"
          role="switch"
          aria-checked="false"
          class="inline-flex min-h-11 items-center gap-3 font-medium text-text-primary"
          data-toggle-all
        >
          {showcase.toggleLabel}
          <span
            aria-hidden="true"
            class="inline-flex h-6 w-11 items-center rounded-full bg-border-strong px-1 transition-colors data-[checked=true]:bg-brand-strong"
            data-toggle-track
            data-checked="false"
          >
            <span class="size-4 rounded-full bg-surface-default transition-transform data-[checked=true]:translate-x-5" data-toggle-thumb data-checked="false"></span>
          </span>
        </button>
      </div>
      <article aria-label={showcase.articleLabel} data-article>
        <pre class="m-0 whitespace-pre-wrap break-words font-mono text-base leading-7">{sourceParts.map((part) => {
          if (part.kind === "text") return <SourceTokens tokens={part.tokens} />;

          return (
            <span
              role="button"
              tabindex="0"
              aria-label={`${showcase.beforeLabel}: ${part.before} ${showcase.afterLabel}: ${part.after}`}
              class="inline cursor-pointer scroll-mt-16 whitespace-pre-wrap font-mono font-medium text-text-primary"
              data-change
              data-state="before"
              aria-pressed="false"
            ><span data-before><SourceTokens tokens={part.beforeTokens} tone="before" /></span><span data-after hidden><SourceTokens tokens={part.afterTokens} tone="after" /></span></span>
          );
        })}</pre>
      </article>
    </div>

    <section aria-labelledby="changes-title" class="mt-16 pb-24">
      <h2 id="changes-title" class="text-section font-semibold">{showcase.changesTitle}</h2>
      <div class="mt-8">
        {groupedExamples.map((group) => (
          <section aria-labelledby={`group-${group.id}`}>
            <h3 id={`group-${group.id}`} class="text-item font-semibold">{group.title}</h3>
            <ol class="mt-4">
              {group.examples.map((example, index) => (
                <li class="border-t border-border-default py-9 first:border-t-0 first:pt-0">
                  <h4 class="text-base font-semibold">{showcase.changeLabel} {index + 1}</h4>
                  <div class="mt-4">
                    <p class="text-sm font-medium text-text-muted">{showcase.beforeLabel}</p>
                    <p class="change-example mt-2 whitespace-pre-wrap text-base text-text-secondary">{example.parts.map((part) => part.kind === "text" ? part.text : <span class="bg-change-before font-medium text-text-primary">{part.before}</span>)}</p>
                  </div>
                  <div class="mt-6">
                    <p class="text-sm font-medium text-text-muted">{showcase.afterLabel}</p>
                    <p class="change-example mt-2 whitespace-pre-wrap text-base text-text-secondary">{example.parts.map((part) => part.kind === "text" ? part.text : <span class="bg-change-after font-medium text-text-primary">{part.after}</span>)}</p>
                  </div>
                  <div class="mt-6">
                    <p class="text-sm font-medium text-text-muted">{showcase.reasonLabel}</p>
                    <p class="mt-2 text-base text-text-secondary">{example.section.reason}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </section>
  </main>
  <PageFooter text={footer.text} topLabel={footer.topLabel} />
  </div>
</BaseLayout>

<style>
  .showcase-page {
    --container-page: var(--container-showcase);
  }

  .home-link {
    color: var(--color-brand-strong);
  }

  @media (hover: hover) {
    .home-link:hover {
      background: var(--color-brand-strong);
      color: var(--color-surface-default);
    }
  }

  .change-example {
    overflow-wrap: anywhere;
  }
</style>

<script>
  const showcase = document.querySelector<HTMLElement>("[data-showcase]");
  const toggle = showcase?.querySelector<HTMLButtonElement>("[data-toggle-all]");
  const article = showcase?.querySelector<HTMLElement>("[data-article]");
  const changes = Array.from(showcase?.querySelectorAll<HTMLElement>("[data-change]") ?? []);

  if (toggle && article && changes.length > 0) {
    const track = toggle.querySelector<HTMLElement>("[data-toggle-track]");
    const thumb = toggle.querySelector<HTMLElement>("[data-toggle-thumb]");

    const syncToggle = () => {
      const allAfter = changes.every((change) => change.dataset.state === "after");
      toggle.setAttribute("aria-checked", String(allAfter));
      if (track) track.dataset.checked = String(allAfter);
      if (thumb) thumb.dataset.checked = String(allAfter);
    };

    const setChange = (change: HTMLElement, after: boolean) => {
      const beforeText = change.querySelector<HTMLElement>("[data-before]");
      const afterText = change.querySelector<HTMLElement>("[data-after]");

      if (!beforeText || !afterText) return;

      beforeText.hidden = after;
      afterText.hidden = !after;
      change.dataset.state = after ? "after" : "before";
      change.setAttribute("aria-pressed", String(after));
    };

    const activateChange = (event: MouseEvent | KeyboardEvent) => {
      if (!(event.target instanceof Element)) return;

      const change = event.target.closest<HTMLElement>("[data-change]");
      if (!change) return;

      if (event instanceof KeyboardEvent) {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        if (event.repeat) return;
      }

      setChange(change, change.dataset.state !== "after");
      syncToggle();
    };

    article.addEventListener("click", activateChange);
    article.addEventListener("keydown", activateChange);

    toggle.addEventListener("click", () => {
      const allAfter = toggle.getAttribute("aria-checked") === "true";
      for (const change of changes) setChange(change, !allAfter);
      syncToggle();
    });
  }
</script>

---
import type { SourcePart } from "../model/source";

interface Props {
  tokens: Extract<SourcePart, { kind: "text" }>["tokens"];
  tone?: "before" | "after";
}

const { tokens, tone } = Astro.props;
---

{tokens.map((token) => (
  <span class="source-token" data-syntax={token.kind} data-tone={tone} data-marked={token.text.trim().length > 0}>
    {token.text}
  </span>
))}

<style>
  .source-token[data-syntax="heading"] {
    font-weight: 600;
  }

  .source-token[data-syntax="marker"] {
    color: var(--color-text-muted);
  }

  .source-token[data-tone] {
    font-weight: 500;
  }

  .source-token[data-tone="before"][data-marked="true"] {
    background: var(--color-change-before);
  }

  .source-token[data-tone="after"][data-marked="true"] {
    background: var(--color-change-after);
  }
</style>

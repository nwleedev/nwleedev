{
  "name": "nwleedev-workspace",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "notes:build": "pnpm --filter notes-app build",
    "notes:cloudflare:build": "pnpm --filter notes-app cloudflare:build",
    "notes:cloudflare:deploy": "pnpm --filter notes-app cloudflare:deploy",
    "notes:cloudflare:preview": "pnpm --filter notes-app cloudflare:preview",
    "notes:dev": "pnpm --filter notes-app dev",
    "notes:lint": "pnpm --filter notes-app lint",
    "notes:start": "pnpm --filter notes-app start",
    "notes:test": "pnpm --filter notes-app test",
    "notes:test:e2e": "pnpm --filter notes-app test:e2e",
    "notes:typecheck": "pnpm --filter notes-app typecheck",
    "entry:build": "pnpm --filter entry build",
    "entry:check": "pnpm --filter entry check",
    "entry:dev": "pnpm --filter entry dev",
    "entry:preview": "pnpm --filter entry preview"
  }
}

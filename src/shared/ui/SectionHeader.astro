---
interface Props {
  id: string;
  title: string;
  introduction?: string;
}

const { id, title, introduction } = Astro.props;
---

<header class="border-t border-border-strong pt-5">
  <h2 id={id} class="text-section font-semibold text-text-primary">
    {title}
  </h2>
  {introduction && (
    <p class="mt-3 text-base leading-7 text-text-secondary">
      {introduction}
    </p>
  )}
</header>

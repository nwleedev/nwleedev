---
interface Props {
  id: string;
  index: string;
  title: string;
  introduction?: string;
}

const { id, index, title, introduction } = Astro.props;
---

<header class="grid gap-4 border-t border-border-strong pt-5 md:grid-cols-12 md:gap-8">
  <p class="text-sm font-semibold tracking-[0.14em] text-brand-strong" aria-hidden="true">
    {index}
  </p>
  <div class="md:col-span-8 md:col-start-4">
    <h2 id={id} class="text-section font-bold tracking-[-0.025em] text-text-primary">
      {title}
    </h2>
    {introduction && (
      <p class="mt-4 max-w-copy text-base leading-7 text-text-secondary">
        {introduction}
      </p>
    )}
  </div>
</header>

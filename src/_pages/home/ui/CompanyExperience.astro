---
import type { CompanyExperience as CompanyExperienceTerms } from "@/shared/terms";
import ContributionBlock from "./ContributionBlock.astro";

interface Props {
  company: CompanyExperienceTerms;
}

const { company } = Astro.props;
---

<article class="border-t border-border-default py-10 md:py-12">
  <header>
    <p class="text-sm font-semibold text-brand-strong">{company.period}</p>
    <h3 class="mt-3 text-item font-semibold text-text-primary">
      {company.company}
    </h3>
    <p class="mt-1 text-sm font-medium text-text-muted">{company.role}</p>
  </header>
  <div class="mt-6">
    <p class="text-base leading-7 text-text-secondary">{company.summary}</p>
    <div class="mt-8">
      {company.contributions.map((contribution) => (
        <ContributionBlock contribution={contribution} />
      ))}
    </div>
  </div>
</article>

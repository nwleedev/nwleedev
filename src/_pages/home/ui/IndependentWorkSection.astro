---
import type { HomeTerms } from "@/shared/terms";
import { MetadataLine, SectionHeader } from "@/shared/ui";

type IndependentWorkTerms = HomeTerms["independentWork"];

interface Props {
  independentWork: IndependentWorkTerms;
}

const { independentWork } = Astro.props;
---

<section aria-labelledby={independentWork.id} class="pb-16 md:pb-24">
  <SectionHeader
    id={independentWork.id}
    title={independentWork.title}
    introduction={independentWork.introduction}
  />
  <ul class="mt-10 border-b border-border-default">
    {independentWork.items.map((item) => (
      <li class="border-t border-border-default py-9 md:py-10">
        <h3 class="text-item font-semibold text-text-primary">{item.title}</h3>
        <p class="mt-4 text-base leading-7 text-text-secondary">{item.summary}</p>
        <div class="mt-7">
          <MetadataLine period={item.period} technologies={item.technologies} />
        </div>
      </li>
    ))}
  </ul>
</section>

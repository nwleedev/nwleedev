---
import type { ExternalLink, HomeTerms, Locale } from "@/shared/terms";

type LanguageTerms = HomeTerms["language"];
type MenuTerms = HomeTerms["menu"];

interface Props {
  language: LanguageTerms;
  links: readonly ExternalLink[];
  locale: Locale;
  menu: MenuTerms;
}

const { language, links, locale, menu } = Astro.props;
---

<profile-navigation class="contents">
  <button
    type="button"
    class="drawer-trigger absolute end-0 top-16 size-11 items-center justify-center border-0 bg-transparent p-0 text-brand-strong hover:text-brand-hover"
    aria-controls="profile-drawer"
    aria-expanded="false"
    aria-label={menu.openLabel}
    data-drawer-open
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      width="24"
      height="24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <path d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>

  <ul class="mt-7 hidden flex-wrap gap-x-6 gap-y-3 sm:flex">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          class="inline-flex min-h-6 items-center font-semibold text-brand-strong decoration-brand-base hover:text-brand-hover"
          aria-label={`${link.label}: ${link.context}`}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>

  <nav aria-label={language.label} class="absolute end-0 top-16 hidden sm:block">
    <ul class="flex gap-4 text-sm font-semibold text-text-muted">
      {language.links.map((link) => (
        <li>
          <a
            class:list={[
              "inline-flex min-h-6 items-center",
              link.locale === locale && "text-brand-strong no-underline",
            ]}
            href={link.href}
            aria-current={link.locale === locale ? "page" : undefined}
            lang={link.locale}
            hreflang={link.locale}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <dialog
    id="profile-drawer"
    class="profile-drawer text-text-primary sm:hidden"
    aria-labelledby="profile-drawer-title"
  >
    <div class="flex min-h-full flex-col px-6 pb-8 pt-5">
      <header class="flex min-h-11 items-center justify-between gap-4 border-b border-border-default pb-4">
        <h2 id="profile-drawer-title" class="text-section font-semibold">
          {menu.title}
        </h2>
        <form method="dialog">
          <button
            type="submit"
            class="inline-flex min-h-11 items-center font-semibold text-brand-strong underline decoration-brand-base hover:text-brand-hover"
            autofocus
          >
            {menu.closeLabel}
          </button>
        </form>
      </header>

      <ul class="mt-8 flex flex-col gap-2">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="inline-flex min-h-11 w-full items-center text-section font-semibold text-text-primary decoration-brand-base hover:text-brand-hover"
              aria-label={`${link.label}: ${link.context}`}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <nav aria-label={language.label} class="mt-8 border-t border-border-default pt-6">
        <ul class="flex gap-4 text-sm font-semibold text-text-muted">
          {language.links.map((link) => (
            <li>
              <a
                class:list={[
                  "inline-flex min-h-11 items-center",
                  link.locale === locale && "text-brand-strong no-underline",
                ]}
                href={link.href}
                aria-current={link.locale === locale ? "page" : undefined}
                lang={link.locale}
                hreflang={link.locale}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </dialog>

  <noscript>
    <div class="mt-7 sm:hidden">
      <ul class="flex flex-col gap-2">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="inline-flex min-h-11 items-center font-semibold text-brand-strong decoration-brand-base"
              aria-label={`${link.label}: ${link.context}`}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <nav aria-label={language.label} class="mt-6">
        <ul class="flex gap-4 text-sm font-semibold text-text-muted">
          {language.links.map((link) => (
            <li>
              <a
                class:list={[
                  "inline-flex min-h-11 items-center",
                  link.locale === locale && "text-brand-strong no-underline",
                ]}
                href={link.href}
                aria-current={link.locale === locale ? "page" : undefined}
                lang={link.locale}
                hreflang={link.locale}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </noscript>
</profile-navigation>

<script>
  class ProfileNavigation extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready === "true") return;

      const openButton = this.querySelector<HTMLButtonElement>("[data-drawer-open]");
      const dialog = this.querySelector<HTMLDialogElement>("dialog");

      if (!openButton || !dialog) return;

      const desktopMedia = window.matchMedia("(min-width: 40rem)");

      openButton.addEventListener("click", () => {
        if (dialog.open) return;

        dialog.showModal();
        openButton.setAttribute("aria-expanded", "true");
        document.documentElement.classList.add("profile-drawer-open");
      });

      dialog.addEventListener("close", () => {
        openButton.setAttribute("aria-expanded", "false");
        document.documentElement.classList.remove("profile-drawer-open");
      });

      desktopMedia.addEventListener("change", (event) => {
        if (event.matches && dialog.open) dialog.close();
      });

      this.dataset.ready = "true";
    }
  }

  if (!customElements.get("profile-navigation")) {
    customElements.define("profile-navigation", ProfileNavigation);
  }
</script>

<style>
  .drawer-trigger {
    display: none;
  }

  .profile-drawer {
    inset-block: 0;
    inset-inline: auto 0;
    width: min(22rem, calc(100% - 2rem));
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-inline-start: 1px solid var(--color-border-strong);
    background: var(--color-surface-default);
  }

  .profile-drawer::backdrop {
    background: color-mix(in srgb, var(--color-text-primary) 48%, transparent);
  }

  :global(html.profile-drawer-open) {
    overflow: hidden;
  }

  @media (width < 40rem) {
    profile-navigation[data-ready="true"] .drawer-trigger {
      display: inline-flex;
    }
  }

  @media (width >= 40rem) {
    .profile-drawer {
      display: none;
    }
  }
</style>

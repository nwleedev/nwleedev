---
import type { HomeTerms } from "@/shared/terms";
import { ExternalTextLink, SectionHeader } from "@/shared/ui";

type OpenSourceTerms = HomeTerms["openSource"];

interface Props {
  openSource: OpenSourceTerms;
}

const { openSource } = Astro.props;
---

<section aria-labelledby={openSource.id} class="pb-16 md:pb-24">
  <SectionHeader id={openSource.id} title={openSource.title} />
  <div class="mt-8 border-b border-border-default">
    {openSource.contributions.map((contribution) => (
      <article class="border-t border-border-default py-9 first:border-t-0 first:pt-0 md:py-10">
        <p class="text-sm font-semibold text-brand-strong">{contribution.release}</p>
        <h3 class="mt-2 text-item font-semibold text-text-primary">
          {contribution.project}
        </h3>
        <p class="mt-5 text-base leading-7 text-text-primary">{contribution.summary}</p>
        <p class="mt-3 text-sm leading-6 text-text-secondary">{contribution.verification}</p>
        <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
          {contribution.links.map((link) => (
            <li><ExternalTextLink link={link} /></li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>

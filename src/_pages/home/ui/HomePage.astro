---
import { getTerms, type Locale } from "@/shared/terms";
import { BaseLayout } from "@/shared/ui";
import BackgroundSection from "./BackgroundSection.astro";
import ContactSection from "./ContactSection.astro";
import ExperienceSection from "./ExperienceSection.astro";
import IdentityBlock from "./IdentityBlock.astro";
import IndependentWorkSection from "./IndependentWorkSection.astro";
import OpenSourceSection from "./OpenSourceSection.astro";
import PageHeader from "./PageHeader.astro";
import PageFooter from "./PageFooter.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const resumeUrl = import.meta.env.PUBLIC_RESUME_URL;
const terms = resumeUrl ? getTerms(locale, { resumeUrl }) : getTerms(locale);
---

<BaseLayout
  locale={locale}
  title={terms.meta.title}
  description={terms.meta.description}
>
  <a
    href="#main-content"
    class="fixed start-4 top-4 z-50 -translate-y-24 bg-text-primary px-4 py-2 text-surface-default focus:translate-y-0"
  >
    {terms.skipLink}
  </a>
  <PageHeader
    name={terms.identity.name}
    label={terms.navigation.label}
    items={terms.navigation.items}
  />
  <main id="main-content" tabindex="-1">
    <IdentityBlock identity={terms.identity} />
    <ExperienceSection experience={terms.experience} />
    <OpenSourceSection openSource={terms.openSource} />
    <IndependentWorkSection independentWork={terms.independentWork} />
    <BackgroundSection background={terms.background} />
    <ContactSection contact={terms.contact} />
  </main>
  <PageFooter text={terms.footer.text} topLabel={terms.footer.topLabel} />
</BaseLayout>

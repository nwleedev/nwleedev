---
import type { HomeTerms } from "@/shared/terms";
import { ExternalTextLink, SectionHeader } from "@/shared/ui";

type ContactTerms = HomeTerms["contact"];

interface Props {
  contact: ContactTerms;
}

const { contact } = Astro.props;
---

<section aria-labelledby={contact.id} class="py-18 md:py-22">
  <SectionHeader
    id={contact.id}
    title={contact.title}
    introduction={contact.introduction}
  />
  <ul class="mt-10 border-b border-border-default">
    {contact.links.map((link) => (
      <li class="border-t border-border-default py-5">
        <ExternalTextLink link={link} />
        <p class="mt-1 text-sm leading-6 text-text-muted">{link.context}</p>
      </li>
    ))}
  </ul>
</section>

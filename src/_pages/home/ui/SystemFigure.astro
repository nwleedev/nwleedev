---
interface Props {
  label: string;
  steps: readonly string[];
}

const { label, steps } = Astro.props;
---

<figure class="@container mt-6 border-s-2 border-brand-base ps-5">
  <ol class="grid gap-2 @min-[34rem]:grid-cols-[repeat(3,minmax(0,1fr))] @min-[34rem]:items-center">
    {steps.map((step, index) => (
      <li class="flex items-center gap-2 text-sm font-semibold text-text-primary">
        <span>{step}</span>
        {index < steps.length - 1 && (
          <span aria-hidden="true" class="text-brand-strong @min-[34rem]:ms-auto">→</span>
        )}
      </li>
    ))}
  </ol>
  <figcaption class="mt-3 text-sm leading-6 text-text-muted">{label}</figcaption>
</figure>
